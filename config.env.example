# Copy this file to config.env and fill it in.
# config.env is gitignored — real values never belong in the repo.

# https://my.telegram.org  ->  API development tools
API_ID=
API_HASH=

# @BotFather -> /newbot
BOT_TOKEN=

# Your own numeric Telegram id. Ask @userinfobot if you don't know it.
# Only this account can talk to the bot.
ADMIN_ID=

# --- optional ---------------------------------------------------------------
# Where sessions and in-flight downloads live, relative to the repo.
DATA_DIR=data
# Ceiling for a single /batch range.
MAX_BATCH=200
